# Local development uses 127.0.0.1:4173. Node.js 24 or newer is required.
HOST=127.0.0.1
PORT=4173
DATA_DIR=./data
REFRESH_MINUTES=60
AUTO_REFRESH=true

# Docker Compose pulls the published image; no source checkout is required.
RESEARCH_READER_IMAGE=ghcr.io/wdenton2/research-reader:latest
# Default: reverse proxy running on the same host.
# For direct LAN access, set the host's LAN IP (or 0.0.0.0 for all interfaces).
READER_BIND_IP=127.0.0.1
READER_PORT=4173

# Required for production/network access. Choose a long unique password.
APP_PASSWORD=
# Set the exact browser-facing origin behind a reverse proxy, without a trailing slash.
# PUBLIC_URL=https://reader.example.com
# Use only if your reverse proxy already authenticates every request and direct access is blocked.
TRUST_PROXY_AUTH=false

# Optional: a real contact email enables Unpaywall's DOI lookup.
UNPAYWALL_EMAIL=
NCBI_EMAIL=

# Optional fallback: Zotero can now be connected from Settings in the app.
# UI connection settings take precedence, including an explicit disconnect.
# Direct saving sends citation metadata only.
# Create a dedicated key at https://www.zotero.org/settings/keys with library write access.
ZOTERO_USER_ID=
ZOTERO_API_KEY=
# Optional collection key; omit to save at the library root.
ZOTERO_COLLECTION_KEY=
