{
  "name": "research-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build",
    "format": "prettier --write src server shared 'test/*.test.js' index.html package.json README.md docs/*.md compose.yaml"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "he": "^1.2.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "vite": "^7.1.0"
  }
}
